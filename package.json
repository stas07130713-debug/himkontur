{
  "name": "ahov-decision-support",
  "private": true,
  "version": "0.2.1",
  "description": "Автономная система поддержки решений при химической аварии",
  "author": "Проект АХОВ",
  "main": "desktop/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:acceptance": "node scripts/acceptance-test.mjs",
    "test:input-layout": "node scripts/input-panel-layout-audit.mjs",
    "test:mobile-layout": "node scripts/mobile-layout-audit.mjs",
    "test:watch": "vitest",
    "data:emergency-cards": "node scripts/build-structured-emergency-cards.mjs",
    "data:complete-hazmat": "node scripts/build-complete-hazmat-database.mjs",
    "audit:card-coverage": "node scripts/audit-card-coverage.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run test && npm run build",
    "icon:generate": "electron scripts/generate-icon.mjs",
    "desktop:dir": "npm run build && npm run icon:generate && electron-builder --dir --win",
    "desktop:win": "npm run build && npm run icon:generate && electron-builder --win",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@protomaps/basemaps": "^5.7.2",
    "docx": "^9.5.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "maplibre-gl": "^6.9.1",
    "pdfmake": "^0.2.20",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.35.0",
    "@types/pdfmake": "^0.2.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cheerio": "^1.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "tar": "7.5.22",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "ru.ahov.forecast",
    "productName": "ХИМКОНТУР",
    "asar": true,
    "directories": {
      "output": "release/windows",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "fileAssociations": [
        {
          "ext": "himkontur",
          "name": "Расчёт ХИМКОНТУР",
          "description": "Сохранённый сценарий расчёта ХИМКОНТУР",
          "icon": "build/icon.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "artifactName": "HIMKONTUR-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ХИМКОНТУР"
    },
    "portable": {
      "artifactName": "HIMKONTUR-${version}-${arch}-Portable.${ext}"
    }
  }
}
